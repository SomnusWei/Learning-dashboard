{
  "manifest_version": 3,
  "name": "学习台剪藏",
  "version": "1.0.0",
  "description": "将网页内容或选中文字剪藏到个人学习工作台待办",
  "permissions": ["contextMenus", "storage", "notifications", "activeTab"],
  "host_permissions": ["https://your-domain.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "学习台剪藏"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
